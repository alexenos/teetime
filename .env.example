# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Channel: "sms" or "whatsapp" (use "whatsapp" for WhatsApp sandbox)
TWILIO_CHANNEL=whatsapp

# Discord Configuration (used when MESSAGING_CHANNEL=discord)
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=your_bot_token
# Your Discord user ID (enable Developer Mode, right-click your name -> Copy User ID)
DISCORD_USER_ID=123456789012345678
# Messaging channel: "twilio" or "discord"
MESSAGING_CHANNEL=twilio

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Model used to parse incoming messages. Defaults to the floating "latest" alias
# so a model retirement can't take message parsing down; pin a version here to
# override (check availability first - retired models return 404).
GEMINI_MODEL=gemini-flash-latest

# Walden Golf Club Credentials
WALDEN_MEMBER_NUMBER=your_member_number
WALDEN_PASSWORD=your_password
WALDEN_BASE_URL=https://www.waldengolf.com

# Run the 6:30 booking chain as direct PrimeFaces HTTP calls instead of browser
# clicks. Login, navigation and slot discovery still run in Chrome; only the
# race moves to HTTP, and any failure before the reservation is submitted falls
# back to the JavaScript chain. Verify the transport first with:
#   poetry run python scripts/probe_direct_http.py
WALDEN_DIRECT_HTTP_BOOKING=false

# User Configuration
USER_PHONE_NUMBER=+1234567890

# Database (for local development, use SQLite)
DATABASE_URL=sqlite+aiosqlite:///./teetime.db

# Booking Configuration
TIMEZONE=America/Chicago
BOOKING_OPEN_HOUR=6
BOOKING_OPEN_MINUTE=30
DAYS_IN_ADVANCE=7
MAX_TEE_TIMES_PER_DAY=2

# Cloud Scheduler Configuration
# API key for authenticating scheduled job requests
# Generate a secure random key: openssl rand -hex 32
SCHEDULER_API_KEY=your_scheduler_api_key
